#!/bin/sh
# caesar N [FILE]     shift every letter N places along the alphabet (N can be negative)
# caesar --all [FILE] try all 25 shifts, one line each
usage() {
  echo "Usage: caesar N [FILE]      shift each letter N places (A+3 = D). Use a negative N to go back."
  echo "       caesar --all [FILE]  try every shift from 1 to 25 and show the first line of each"
  echo "Reads the FILE, or what is piped in. Digits, spaces and symbols are left alone."
}
case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
esac
mode=$1; shift
if [ "$mode" = "--all" ]; then
  awk 'function rot(s, n,   i, c, o, p, L, U) { L = "abcdefghijklmnopqrstuvwxyz"; U = toupper(L); o = ""
         for (i = 1; i <= length(s); i++) { c = substr(s, i, 1)
           if ((p = index(L, c)) > 0) c = substr(L, (p - 1 + n) % 26 + 1, 1)
           else if ((p = index(U, c)) > 0) c = substr(U, (p - 1 + n) % 26 + 1, 1)
           o = o c }
         return o }
       NR == 1 { line = $0 } END { for (n = 1; n <= 25; n++) printf "shift %2d: %s\n", n, substr(rot(line, n), 1, 68) }' "$@"
  exit 0
fi
case "$mode" in -[0-9]*|[0-9]*) ;; *) usage; exit 1 ;; esac
awk -v n="$mode" 'BEGIN { n = ((n % 26) + 26) % 26; L = "abcdefghijklmnopqrstuvwxyz"; U = toupper(L) }
  { o = ""
    for (i = 1; i <= length($0); i++) { c = substr($0, i, 1)
      if ((p = index(L, c)) > 0) c = substr(L, (p - 1 + n) % 26 + 1, 1)
      else if ((p = index(U, c)) > 0) c = substr(U, (p - 1 + n) % 26 + 1, 1)
      o = o c }
    print o }' "$@"
