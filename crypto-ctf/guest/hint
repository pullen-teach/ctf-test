#!/bin/sh
# hint N           shows the hints you already have and the price of the next one
# hint N --show    buys the next hint. Each hint costs 5% of the mission's points,
# charged once: the page keeps the score when it sees the [quest] line. The warm-up hint is free.
# Generated by guest/make-missions.py: edit that file, not this one.
case "$1" in
  0) echo 'Mission 0: The flag is on the last line of orientation.txt in your
home folder. Type cat orientation.txt, press Enter, then copy the
flag into submit.'; exit 0 ;;
  1) pts=100; cost=5; total=1
     h1='base64 --help lists an option that decodes. Put it between base64
and the file name.'
     ;;
  2) pts=100; cost=5; total=1
     h1='Read xxd --help: -r reverses hex back into text, and -p says the
hex is plain (no addresses or columns). You need both: xxd -r -p
signal.hex.'
     ;;
  3) pts=100; cost=5; total=1
     h1='caesar --help shows how to shift letters. ROT13 is a shift of 13,
and doing it again undoes it: caesar 13 note.txt.'
     ;;
  4) pts=200; cost=10; total=2
     h1='caesar --all scroll.txt tries every shift on the first line. Look
for the one that reads as English.'
     h2='Found the readable line? Note its shift number N, then decode the
whole file with caesar N scroll.txt. The flag is on the second
line.'
     ;;
  5) pts=200; cost=10; total=2
     h1='Recognise the outside layer: only 0-9 and a-f means hex (xxd -r
-p); mixed-case letters, digits, +, / and = means base64 (base64
-d).'
     h2='ROT13 is the innermost layer. Peel the other two first, piping
each step into the next, then finish with | caesar 13.'
     ;;
  6) pts=200; cost=10; total=2
     h1='sha256sum keys/* fingerprints every key at once. Compare each one
with the hash in README.txt.'
     h2='Let the computer compare: sha256sum keys/* | grep ABCD, using the
first few characters of the hash. Then cat the file it names.'
     ;;
  7) pts=400; cost=20; total=3
     h1='Run freq cipher.txt. The most common letter is probably e. Swap it
in capitals: tr '\''x'\'' '\''E'\'' < cipher.txt, using your letter instead of
x.'
     h2='Find the most common three-letter word: it is almost certainly
the. Add those letters to your tr, in the same order: tr '\''xqz'\''
'\''ETH'\'' < cipher.txt. Keep adding pairs.'
     h3='Short words help: a one-letter word is a or i, and is, it, of and
to are common two-letter words. The secret word comes right after
"the secret word is".'
     ;;
  8) pts=400; cost=20; total=2
     h1='Read only the first letter of each line of poem.txt, top to
bottom. They spell the keyword.'
     h2='Decrypt with that keyword: vigenere -d KEYWORD secret.txt. If the
output is still scrambled, check the spelling of the keyword.'
     ;;
  9) pts=800; cost=40; total=4
     h1='Step 1: caesar --all key.txt tries every shift. The readable line
tells you the keyword.'
     h2='Step 2: base64 -d vault.b64 gives scrambled text: that is the
Vigenère ciphertext.'
     h3='Step 3: pipe it into the decryption: base64 -d vault.b64 |
vigenere -d KEYWORD.'
     h4='The flag is on the last line of the decrypted text. Copy it
exactly, from CYBA{ to }.'
     ;;
  *) echo "Usage: hint 1   (up to 9)"; exit 1 ;;
esac
seen=/tmp/.quest-hints
have=$(grep -c "^$1\." "$seen" 2>/dev/null); [ -n "$have" ] || have=0
i=1; while [ "$i" -le "$have" ]; do eval "t=\$h$i"; echo "Hint $i of $total: $t"; i=$((i + 1)); done
if [ "$2" = "--show" ]; then
  if [ "$have" -ge "$total" ]; then echo "No more hints for mission $1."; exit 0; fi
  k=$((have + 1)); echo "$1.$k" >> "$seen"; eval "t=\$h$k"
  echo "Hint $k of $total: $t"
  echo "[quest] hint $1.$k used (-$cost points)"
  exit 0
fi
if [ "$have" -ge "$total" ]; then echo "That is every hint for mission $1."; exit 0; fi
echo "Hint $((have + 1)) of $total costs $cost points (5% of $pts), charged once."
echo "To see it, type:  hint $1 --show"
