#!/bin/sh
# xor KEY [FILE] / xor all [FILE] / xor -e KEY [FILE]: single-byte XOR.
case "$1" in ""|--help|-h) cat <<'EOF'
Usage: xor KEY [FILE]      XOR hex data with KEY (a number from 0 to 255), print text
       xor all [FILE]      try every key from 1 to 255, one line per key
       xor -e KEY [FILE]   XOR text with KEY and print it as hex
Unprintable bytes show as a dot. Reads FILE, or a pipe (|).
EOF
[ -n "$1" ]; exit $? ;; esac
e=0; [ "$1" = "-e" ] && { e=1; shift; }
k=$1; shift
awk -v k="$k" -v enc="$e" '
BEGIN { H = "0123456789abcdef"; for (i = 0; i < 256; i++) ORD[sprintf("%c", i)] = i }
function show(v) { return (v >= 32 && v <= 126) ? sprintf("%c", v) : "." }
enc == 1 { for (i = 1; i <= length($0); i++) out = out sprintf("%02x", xor(ORD[substr($0, i, 1)], k)); out = out sprintf("%02x", xor(10, k)); next }
{ s = s tolower($0) }
END {
  if (enc == 1) { print out; exit }
  gsub(/[^0-9a-f]/, "", s); nb = 0
  for (i = 1; i < length(s); i += 2) b[++nb] = (index(H, substr(s, i, 1)) - 1) * 16 + index(H, substr(s, i + 1, 1)) - 1
  if (k == "all") { for (kk = 1; kk < 256; kk++) { o = "key " kk ": "; for (i = 1; i <= nb; i++) o = o show(xor(b[i], kk)); print o } }
  else { o = ""; for (i = 1; i <= nb; i++) { v = xor(b[i], k + 0); o = o (v == 10 ? "\n" : show(v)) } printf "%s", o; if (substr(o, length(o)) != "\n") print "" }
}' "$@"
