#!/bin/sh
# Builds the ten Crypto CTF missions. Flags are random on every boot. Only SHA-256
# hashes of the flags are kept (/etc/quest), so there is no answer file to read.
H=/home/player
Q=/etc/quest
R=/usr/share/quest
mkdir -p "$Q"
hex()  { head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
flag() { printf 'CYBA{%s-%s}' "$1" "$(hex)"; }
pick() { printf '%s\n' "$@" | shuf -n1; }
num()  { awk -v s="$(hex | cut -c1-6)" -v n="$1" 'BEGIN { srand(("0x" s) + 0); print 1 + int(rand() * n) }'; }
keep() { printf '%s' "$2" | sha256sum | cut -d' ' -f1 > "$Q/$1"; }
# room N [clue]: the mission folder and its README.txt (this run's clue on top, then the brief)
room() { mkdir -p "$H/mission$1"; { [ -n "$2" ] && { printf "$2"; echo; }; cat "$R/$1.txt"; } > "$H/mission$1/README.txt"; }

cp "$R/home.txt" "$H/README.txt"
# 0: warm-up (optional, untimed). Its flag is the last line of the CTF orientation.
F=$(flag warmup); keep 0 "$F"
{ cat "$R/orientation.txt"; echo "  $F"; } > "$H/orientation.txt"

# 1: base64 (encoding is not encryption)
F=$(flag b64); keep 1 "$F"; room 1
printf 'Encoding is not encryption. Anyone can decode this.\nFlag: %s\n' "$F" | base64 > "$H/mission1/message.b64"

# 2: hex
F=$(flag hex); keep 2 "$F"; room 2
printf 'Hex decoded! Every two characters were one letter.\nFlag: %s\n' "$F" | xxd -p > "$H/mission2/secret.hex"

# 3: ROT13 with tr
F=$(flag rot); keep 3 "$F"; room 3
printf 'ROT13 is a fun puzzle, not real security.\nFlag: %s\n' "$F" | tr 'A-Za-z' 'N-ZA-Mn-za-m' > "$H/mission3/message.txt"

# 4: Caesar with an unknown shift (brute force)
s=$(num 25); [ "$s" = 13 ] && s=7
F=$(flag caesar); keep 4 "$F"; room 4
printf 'Veni, vidi, vici. You cracked Caesar.\nFlag: %s\n' "$F" | caesar "$s" > "$H/mission4/message.txt"

# 5: Atbash with tr
F=$(flag mirror); keep 5 "$F"; room 5
printf 'Through the looking glass.\nFlag: %s\n' "$F" | tr 'A-Za-z' 'ZYXWVUTSRQPONMLKJIHGFEDCBAzyxwvutsrqponmlkjihgfedcba' > "$H/mission5/mirror.txt"

# 6: Morse; the flag is built from the decoded code
code=$(hex | tr 'a-f' 'A-F')
F="CYBA{morse-$(echo "$code" | tr 'A-F' 'a-f')}"; keep 6 "$F"
room 6 "Decode signal.txt. It spells out a code.\nThe flag is CYBA{morse-CODE}, with the code in lowercase.\n"
echo "THE CODE IS $code" | morse -e > "$H/mission6/signal.txt"

# 7: crack a SHA-256 against a list of candidates
F=$(flag hash); keep 7 "$F"
room 7 "One line of candidates.txt has the SHA-256 fingerprint in target.sha256.\nThat line is the flag.\n"
{ echo "$F"; i=1; while [ "$i" -lt 100 ]; do echo "CYBA{hash-$(hex)}"; i=$((i + 1)); done; } | shuf > "$H/mission7/candidates.txt"
printf '%s' "$F" | sha256sum | cut -d' ' -f1 > "$H/mission7/target.sha256"

# 8: single-byte XOR
k=$(num 255)
F=$(flag xor); keep 8 "$F"; room 8
printf 'XOR is everywhere in modern cryptography.\nFlag: %s\n' "$F" | xor -e "$k" | fold -w 60 > "$H/mission8/cipher.hex"

# 9: Vigenere; the keyword is in a ROT13 briefing
kw=$(pick FALCON ORCHID JUPITER GLACIER PHOENIX LANTERN COMPASS HARBOR)
F=$(flag vig); keep 9 "$F"; room 9
echo "BRIEFING: The keyword is $kw. Tell no one." | tr 'A-Za-z' 'N-ZA-Mn-za-m' > "$H/mission9/briefing.txt"
printf 'Vigenere kept its secrets for three hundred years.\nFlag: %s\n' "$F" | vigenere -e "$kw" > "$H/mission9/secret.txt"

# 10: the vault. Crack the keyword's hash, base64-decode, then Vigenere-decrypt.
w=$(shuf -n1 "$R/words.txt")
F=$(flag vault); keep 10 "$F"
room 10 "The keyword is one of the words in words.txt. Its SHA-256 is in key.sha256.\nThe vault (vault.b64) was encrypted with that keyword, then base64-encoded.\n"
cp "$R/words.txt" "$H/mission10/words.txt"
printf '%s' "$w" | sha256sum | cut -d' ' -f1 > "$H/mission10/key.sha256"
printf 'Vault opened. You beat the final mission.\nFlag: %s\n' "$F" | vigenere -e "$w" | base64 > "$H/mission10/vault.b64"

chmod 755 "$Q"; chmod 644 "$Q"/*
chown -R 1000:1000 "$H"
