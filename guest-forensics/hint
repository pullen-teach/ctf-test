#!/bin/sh
# hint N           shows the hints you already have and the price of the next one
# hint N --show    buys the next hint. Each hint costs 5% of the mission's points,
# charged once: the page keeps the score when it sees the [quest] line. The warm-up hint is free.
# Generated by guest-forensics/make-forensics.py: edit that file, not this one.
case "$1" in
  0) echo 'Mission 0: The flag is on the last line of orientation.txt in your
home folder. Type cat orientation.txt, press Enter, then copy the
flag into submit.'; exit 0 ;;
  1) pts=100; cost=5; total=1
     h1='ls -l evidence shows each file'\''s time. Look for the one that
matches the time on the first line of README.txt, then cat it.'
     ;;
  2) pts=100; cost=5; total=1
     h1='strings photo.jpg | head prints the readable text near the start
of the file: that'\''s where the metadata fields live. Look for the
Comment field.'
     ;;
  3) pts=100; cost=5; total=1
     h1='filetype photos/* names every file'\''s real type. One is gzip, not
JPEG. Read it with zcat, using its full path.'
     ;;
  4) pts=200; cost=10; total=2
     h1='Start with tar -xzf evidence.tar.gz, then ls. You'\''ll get a file
with no extension.'
     h2='filetype each new file. A tar archive unpacks with tar -xf NAME;
gzip opens with zcat NAME.'
     ;;
  5) pts=200; cost=10; total=2
     h1='The IP address is field 8: grep Failed auth.log | cut -d'\'' '\'' -f8 |
sort | uniq -c | sort -n. The last line is the busiest IP.'
     h2='Now find that IP'\''s successful login: grep Accepted auth.log | grep
THE-IP.'
     ;;
  6) pts=200; cost=10; total=2
     h1='strings cat.jpg shows the readable text. The appended message is
the last line.'
     h2='It'\''s base64: strings cat.jpg | tail -1 | base64 -d.'
     ;;
  7) pts=200; cost=10; total=2
     h1='sha256sum -c manifest.sha256 checks every file in the list. Look
for the one that says FAILED.'
     h2='Every program has a CYBA build id inside. Read the failed one'\''s:
strings bin/NAME | grep CYBA.'
     ;;
  8) pts=400; cost=20; total=3
     h1='cat cron/* prints every crontab. Most commands are normal system
jobs. Which one points into a hidden folder in this mission?'
     h2='The odd line runs a script under var/.cache/. Hidden files start
with a dot: ls -a var/.cache, then cat the script.'
     h3='The script'\''s PAYLOAD is base64. Copy the text between the quotes
and decode it: echo TEXT | base64 -d.'
     ;;
  9) pts=400; cost=20; total=3
     h1='Only one host sent seq=. Keep those packets: grep seq=
capture.txt.'
     h2='Cut each line down to the values: grep seq= capture.txt | cut
-d'\''?'\'' -f2 | cut -d'\'' '\'' -f1. Then sort puts them in seq order.'
     h3='Keep only the hex after the last =, join it and decode: ... | sort
| cut -d'\''='\'' -f3 | tr -d '\''\n'\'' | xxd -r -p.'
     ;;
  10) pts=800; cost=40; total=4
     h1='Step 1: find the attacker'\''s IP the same way as Mission 5: count
Failed lines per IP (field 8).'
     h2='Step 2: that IP'\''s Accepted line names the user (field 6). Their
folder is homes/USER/.'
     h3='Step 3: filetype homes/USER/*. The file whose type doesn'\''t match
its name is the one.'
     h4='Step 4: zcat it. The text inside is base64: zcat homes/USER/FILE |
base64 -d.'
     ;;
  *) echo "Usage: hint 1   (up to 10)"; exit 1 ;;
esac
seen=/tmp/.quest-hints
have=$(grep -c "^$1\." "$seen" 2>/dev/null); [ -n "$have" ] || have=0
i=1; while [ "$i" -le "$have" ]; do eval "t=\$h$i"; echo "Hint $i of $total: $t"; i=$((i + 1)); done
if [ "$2" = "--show" ]; then
  if [ "$have" -ge "$total" ]; then echo "No more hints for mission $1."; exit 0; fi
  k=$((have + 1)); echo "$1.$k" >> "$seen"; eval "t=\$h$k"
  echo "Hint $k of $total: $t"
  echo "[quest] hint $1.$k used (-$cost points)"
  exit 0
fi
if [ "$have" -ge "$total" ]; then echo "That is every hint for mission $1."; exit 0; fi
echo "Hint $((have + 1)) of $total costs $cost points (5% of $pts), charged once."
echo "To see it, type:  hint $1 --show"
