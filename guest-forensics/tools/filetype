#!/bin/sh
# filetype FILE...: name each file's real type from its first bytes (like the file command).
case "$1" in ""|--help|-h) cat <<'EOT'
Usage: filetype FILE...   name each file's real type from its first bytes
A file name's extension is only a label. The first bytes of a file, its
"magic number", say what it really is:
  ff d8 ff      JPEG image          89 50 4e 47   PNG image
  1f 8b         gzip compressed     25 50 44 46   PDF document
  50 4b 03 04   zip archive         7f 45 4c 46   ELF program
  "ustar" at byte 257: tar archive  only printable bytes: ASCII text
See them yourself:  head -c 16 FILE | xxd
EOT
[ -n "$1" ]; exit $? ;; esac
for f in "$@"; do
  if [ -d "$f" ]; then echo "$f: directory"; continue; fi
  if [ ! -r "$f" ]; then echo "$f: cannot open"; continue; fi
  m=$(head -c 4 "$f" | od -An -tx1 | tr -d ' \n')
  case "$m" in
    ffd8ff*) t="JPEG image data" ;;
    89504e47) t="PNG image data" ;;
    1f8b*) t="gzip compressed data" ;;
    25504446) t="PDF document" ;;
    504b0304) t="Zip archive data" ;;
    7f454c46) t="ELF program" ;;
    "") t="empty" ;;
    *) if [ "$(head -c 262 "$f" | tail -c 5)" = "ustar" ]; then t="POSIX tar archive"
       elif [ "$(head -c 512 "$f" | tr -d '\t\r\n -~' | wc -c)" -gt 0 ]; then t="data"
       else t="ASCII text"; fi ;;
  esac
  echo "$f: $t"
done
