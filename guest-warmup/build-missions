#!/bin/sh
# Builds the two warm-ups (Orientation and Speed drills). Flags are random on
# every boot; only SHA-256 hashes of the flags are kept (/etc/quest).
H=/home/player
Q=/etc/quest
mkdir -p "$Q"
hex()  { head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
flag() { printf 'CYBA{%s-%s}' "$1" "$(hex)"; }
R=/usr/share/quest
keep() { printf '%s' "$2" | sha256sum | cut -d' ' -f1 > "$Q/$1"; }

cp "$R/home.txt" "$H/README.txt"

# Warm-up 1: Orientation. Its flag is the last line of the CTF orientation.
F=$(flag warmup); keep 1 "$F"
{ cat "$R/orientation.txt"; echo "  $F"; } > "$H/orientation.txt"

# Warm-up 2: speed drills. Four 4-character pieces, one per drill:
# Tab completes a long file name, the up arrow repeats "again", Ctrl+C stops "runaway",
# and the mouse copies a code into "pasteit".
p1=$(hex | cut -c1-4); p2=$(hex | cut -c1-4); p3=$(hex | cut -c1-4); p4=$(hex | cut -c1-4)
code=$(hex)$(hex | cut -c1-4)
keep 2 "CYBA{speed-$p1$p2$p3$p4}"
S="$H/speed"; mkdir -p "$S/tab" "$S/paste"
cp "$R/speed.txt" "$S/README.txt"
printf 'Piece 1: %s\nTab finished the name for you. Try it on commands too: type  his  then press Tab.\n' "$p1" > "$S/tab/drill-1-tab-completion-saves-your-fingers-$(hex).txt"
printf 'Drill 4: copy and paste, the Linux way.\nSelect the code below with the mouse (or trackpad) to copy it. Then type  pasteit  and a space, paste the code (middle-click, or right-click), and press Enter.\nCODE: %s\n' "$code" > "$S/paste/code.txt"
cat > /bin/again <<AGAIN
#!/bin/sh
# again: run me 5 times within 15 seconds. The up arrow brings back your last command.
f=/tmp/.again; now=\$(date +%s); set -- \$(cat "\$f" 2>/dev/null); n=\${1:-0}; start=\${2:-0}
if [ \$((now - start)) -gt 15 ]; then n=0; start=\$now; fi
n=\$((n + 1)); echo "\$n \$start" > "\$f"
if [ \$n -ge 5 ]; then rm -f "\$f"; echo "Run 5 of 5 in \$((now - start)) seconds. Fast fingers!"; echo "Piece 2: $p2"; exit 0; fi
echo "Run \$n of 5. Press the up arrow, then Enter. (5 runs within 15 seconds)"
AGAIN
cat > /bin/runaway <<RUNAWAY
#!/bin/sh
# runaway: prints forever until you press Ctrl+C.
trap 'echo; echo "Stopped! Ctrl+C interrupts whatever is running."; echo "Piece 3: $p3"; exit 0' INT
# (sleep returns at once in this tiny kernel, so wait for the uptime clock to tick instead)
tick() { read u _ < /proc/uptime; t=\${u%.*}; while read u _ < /proc/uptime && [ "\${u%.*}" = "\$t" ]; do :; done; }
i=0
while true; do i=\$((i + 1)); echo "Still running (\$i)... press Ctrl+C to stop me"; tick; done
RUNAWAY
cat > /bin/pasteit <<PASTEIT
#!/bin/sh
# pasteit CODE: the copy-and-paste drill. Highlight the long CODE with the mouse and
# paste it (middle-click, or right-click) rather than typing it.
if [ -z "\$1" ]; then echo "pasteit: select the CODE with the mouse, then type  pasteit  and paste it" >&2; exit 1; fi
if [ "\$1" = "$code" ]; then echo "Nice paste! Select, then middle-click (or right-click) beats typing."; echo "Piece 4: $p4"; exit 0; fi
echo "pasteit: that is not the code. Highlight the whole CODE and paste the exact value." >&2; exit 1
PASTEIT
chmod 755 /bin/again /bin/runaway /bin/pasteit
