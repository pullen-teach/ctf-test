#!/bin/sh
# Builds the ten missions. Flags are random on every boot. Only SHA-256 hashes
# of the flags are kept (/etc/quest), so there is no answer file to read.
H=/home/player
Q=/etc/quest
mkdir -p "$Q"
hex()  { head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
flag() { printf 'CYBA{%s-%s}' "$1" "$(hex)"; }
pick() { printf '%s\n' "$@" | shuf -n1; }
rnd()  { head -c 32 /dev/urandom | base64 | tr -dc 'a-z0-9' | cut -c1-"$1"; }
# README.txt texts, written by guest/make-missions.py
R=/usr/share/quest
# clue on top, then the mission brief
clue() { { printf "$2"; echo; cat "$R/$1.txt"; } > "$H/mission$1/README.txt"; }
keep() { printf '%s' "$2" | sha256sum | cut -d' ' -f1 > "$Q/$1"; }
# forge: a little assembler. Reads a file of key parts (one per line) and builds the flag.
cat > /bin/forge <<'FORGE'
#!/bin/sh
if [ -z "$1" ]; then echo "Usage: forge FILE"; exit 1; fi
parts=$(tr -d ' \t\r\n' < "$1")
if [ -z "$parts" ]; then echo "forge: no key parts found. Give me a file of parts, one per line." >&2; exit 1; fi
echo "Forging the key..."
echo "CYBA{forge-$parts}"
FORGE
chmod 755 /bin/forge

# 1: make your move. Signpost file names (read with ls) lead to a file named after the flag.
F=$(flag moves); keep 1 "$F"
set -- $(printf '%s\n' park library market harbor station arcade | shuf | head -n 3)
wrong=$1; right=$2; other=$3
mid=$(pick fountain gazebo tunnel bridge kiosk); end=$(pick locker crate shed cellar toolbox)
M1="$H/mission1"; T1="$M1/town"; E1="$T1/$right/$mid/$end"
mkdir -p "$T1/$wrong" "$T1/$other" "$E1"
# (touch is not available in this small kernel, so ": >" creates the empty files)
for f in "$M1/start-here--go-into-town" \
         "$T1/sign--go-into-the-$wrong" \
         "$T1/$wrong/dead-end--go-back-up-and-try-the-$right" \
         "$T1/$other/nothing-here--go-back-up" \
         "$T1/$right/go-into-the-$mid-then-the-$end" \
         "$T1/$right/$mid/almost-there--keep-going-into-the-$end" \
         "$E1/you-made-it--the-flag-is-the-file-name" \
         "$E1/$F"; do
  : > "$f"
done
cp "$R/home.txt" "$H/README.txt"
cp "$R/1.txt" "$M1/README.txt"

# 2: let the cat out of the bag. cat --help shows -n, which numbers lines.
F=$(flag cat); keep 2 "$F"
mkdir -p "$H/mission2"
line=$(awk -v s="$(hex | cut -c1-6)" 'BEGIN { srand(("0x" s) + 0); print 30 + int(rand() * 66) }')
clue 2 "The cat is hiding in bag.txt.\nEvery line in the bag looks like a flag, but only line $line is real.\n"
awk -v line="$line" -v flag="$F" -v seed="$(hex | cut -c1-6)" 'BEGIN {
  srand(("0x" seed) + 0)
  for (i = 1; i <= 100; i++) {
    if (i == line) { print "meow " flag; continue }
    h = ""; for (k = 0; k < 8; k++) h = h substr("0123456789abcdef", 1 + int(rand() * 16), 1)
    print "meow CYBA{cat-" h "}"
  }
}' > "$H/mission2/bag.txt"

# 3: hidden file (ls -a)
F=$(flag hidden); keep 3 "$F"
mkdir -p "$H/mission3"
cp "$R/3.txt" "$H/mission3/README.txt"
echo "Nothing to see here. Or is there? Some files are shy." > "$H/mission3/notes.txt"
echo "Close, but this hidden file is a decoy." > "$H/mission3/.old-$(rnd 4)"
printf 'You found the hidden file.\nFlag: %s\n' "$F" > "$H/mission3/.$(pick treasure stash secret-notes backup-codes)"

# 4: find by name
F=$(flag finder); keep 4 "$F"
ext=$(pick key gem relic)
# One awk process builds all 20 folders and ~80 files (spawning a process per
# file is slow inside the browser emulator).
awk -v base="$H/mission4/archive" -v ext="$ext" -v flag="$F" -v seed="$(hex | cut -c1-6)" '
function r(n,   s, k) { s = ""; for (k = 0; k < n; k++) s = s substr("abcdefghijklmnopqrstuvwxyz0123456789", 1 + int(rand() * 36), 1); return s }
BEGIN {
  srand(("0x" seed) + 0)
  split("alpha bravo charlie delta echo", A, " "); split("box bin shelf drawer", B, " "); split("txt log dat", E, " ")
  for (a = 1; a <= 5; a++) for (b = 1; b <= 4; b++) { d[++nd] = base "/" A[a] "/" B[1 + int(rand() * 4)] "-" r(4); all = all " " d[nd] }
  system("mkdir -p" all)
  for (k = 1; k <= nd; k++) for (c = 1; c <= 4; c++) { f = d[k] "/" r(6) "." E[1 + int(rand() * 3)]; print "junk " r(20) > f; close(f) }
  f = d[1 + int(rand() * nd)] "/" r(6) "." ext; print "Flag: " flag > f; close(f)
}'
clue 4 "Somewhere in archive/ is ONE file ending in .$ext\nIt holds the flag.\n"

# 5: grep a log
F=$(flag grep); keep 5 "$F"
who=$(pick nightowl ghost_fox zero_cool red_panda pixel_wolf)
mkdir -p "$H/mission5"
awk -v who="$who" -v flag="$F" -v seed="$(hex | cut -c1-6)" 'BEGIN {
  srand(("0x" seed) + 0); split("alice bob carol dave erin frank grace heidi ivan judy", u, " ")
  split("LOGIN_OK LOGIN_FAIL VIEW_PAGE DOWNLOAD LOGOUT", a, " ")
  n = 12000; hit = 1500 + int(rand() * 9000)
  for (i = 0; i < n; i++) {
    t = 8 * 3600 + i
    stamp = sprintf("%02d:%02d:%02d", int(t / 3600) % 24, int(t / 60) % 60, t % 60)
    if (i == hit) printf "%s user=%s action=LOGIN_OK token=%s\n", stamp, who, flag
    else printf "%s user=%s action=%s token=%08x\n", stamp, u[1 + int(rand() * 10)], a[1 + int(rand() * 5)], int(rand() * 2147483647)
  }
}' > "$H/mission5/access.log"
clue 5 "An intruder logged in ONCE as:  $who\nTheir token is the flag.\n"

# 8: find and replace (sed). A junk marker is wedged all through the flag; sed s///g strips it.
F=$(flag sed); keep 8 "$F"
mkdir -p "$H/mission8"
cp "$R/8.txt" "$H/mission8/README.txt"
mk=$(pick QZ XK ZQ VW KX WJ QK ZX)
corrupt=$(printf '%s' "$F" | sed "s/./&$mk/g")
printf 'This file is corrupted: the same junk string was inserted all through the flag below.\nFind the junk, then remove every copy of it to read the flag.\n\nFlag: %s\n' "$corrupt" > "$H/mission8/message.txt"

# 6: odd one out. Every fake code appears 2 to 4 times; the flag once (sort | uniq -u).
F=$(flag odd); keep 6 "$F"
mkdir -p "$H/mission6"; cp "$R/6.txt" "$H/mission6/README.txt"
awk -v flag="$F" -v seed="$(hex | cut -c1-6)" 'BEGIN {
  srand(("0x" seed) + 0); n = 0
  for (i = 0; i < 300; i++) {
    h = ""; for (k = 0; k < 8; k++) h = h substr("0123456789abcdef", 1 + int(rand() * 16), 1)
    c = 2 + int(rand() * 3); for (j = 0; j < c; j++) L[++n] = "CYBA{odd-" h "}"
  }
  L[++n] = flag
  for (i = n; i > 1; i--) { j = 1 + int(rand() * i); t = L[i]; L[i] = L[j]; L[j] = t }
  for (i = 1; i <= n; i++) print L[i]
}' > "$H/mission6/codes.txt"

# 7: permission denied. unlock.sh has no execute bit until the student adds it (chmod +x).
F=$(flag exec); keep 7 "$F"
mkdir -p "$H/mission7"; cp "$R/7.txt" "$H/mission7/README.txt"
printf 'Access granted.  Flag: %s\n' "$F" | rev > "$H/mission7/.door"
printf '#!/bin/sh\n# The vault door. It only opens when this file has execute permission.\nrev ~/mission7/.door\n' > "$H/mission7/unlock.sh"
chmod 644 "$H/mission7/unlock.sh"

# 9: forge the key (awk + > + forge). Three admin rows hold the flag's three parts, in order.
k1=$(hex | cut -c1-4); k2=$(hex | cut -c1-4); k3=$(hex | cut -c1-4)
F="CYBA{forge-$k1$k2$k3}"; keep 9 "$F"
mkdir -p "$H/mission9"; cp "$R/9.txt" "$H/mission9/README.txt"
awk -v k1="$k1" -v k2="$k2" -v k3="$k3" -v seed="$(hex | cut -c1-6)" 'BEGIN {
  srand(("0x" seed) + 0); split("alice bob carol dave erin frank grace heidi ivan judy", u, " "); split("user guest viewer", ro, " ")
  for (i = 1; i <= 24; i++) { t = ""; for (k = 0; k < 4; k++) t = t substr("0123456789abcdef", 1 + int(rand() * 16), 1); L[i] = u[1 + int(rand() * 10)] " " ro[1 + int(rand() * 3)] " " t }
  q1 = 2 + int(rand() * 7); q2 = q1 + 2 + int(rand() * 7); q3 = q2 + 2 + int(rand() * 7)
  A[q1] = u[1 + int(rand() * 10)] " admin " k1; A[q2] = u[1 + int(rand() * 10)] " admin " k2; A[q3] = u[1 + int(rand() * 10)] " admin " k3
  print "user role token"
  j = 0; for (i = 1; i <= 27; i++) { if (i in A) print A[i]; else { j++; print L[j] } }
}' > "$H/mission9/records.txt"

# 10: endgame. Three pieces: a hidden file (find), a token in a log (grep + cut) and a
# locked script (chmod + run). The flag is CYBA{piece1-piece2-piece3}.
p1=$(hex | cut -c1-6); p2=$(hex | cut -c1-6); p3=$(hex | cut -c1-6)
F="CYBA{$p1-$p2-$p3}"; keep 10 "$F"
M="$H/mission10"; mkdir -p "$M"
who=$(pick shadow_byte cipher_cat glitch root_kit null_ptr)
awk -v base="$M/vault" -v p1="$p1" -v seed="$(hex | cut -c1-6)" '
function r(n,   s, k) { s = ""; for (k = 0; k < n; k++) s = s substr("abcdefghijklmnopqrstuvwxyz0123456789", 1 + int(rand() * 36), 1); return s }
BEGIN {
  srand(("0x" seed) + 0)
  split("north south east west", A, " "); split("rack shelf crate", B, " "); split("txt log cfg", E, " ")
  for (a = 1; a <= 4; a++) for (b = 1; b <= 3; b++) { d[++nd] = base "/" A[a] "/" B[b] "-" r(3); all = all " " d[nd] }
  system("mkdir -p" all)
  for (k = 1; k <= nd; k++) for (c = 1; c <= 3; c++) { f = d[k] "/" r(5) "." E[1 + int(rand() * 3)]; print "junk " r(16) > f; close(f) }
  split(".cache .backup .tmp .notes .stash .keep", HN, " ")
  for (i = 6; i > 1; i--) { j = 1 + int(rand() * i); t = HN[i]; HN[i] = HN[j]; HN[j] = t }
  for (i = 1; i <= 3; i++) { f = d[1 + int(rand() * nd)] "/" HN[i]; print "Nothing here. Keep looking." > f; close(f) }
  f = d[1 + int(rand() * nd)] "/" HN[4]; print "piece 1: " p1 > f; close(f)
}'
tok="$p2"
awk -v who="$who" -v tok="$tok" -v seed="$(hex | cut -c1-6)" 'BEGIN {
  srand(("0x" seed) + 0); split("alice bob carol dave erin frank grace heidi ivan judy", u, " ")
  split("LOGIN_OK LOGIN_FAIL SUDO SSH_KEY LOGOUT", a, " ")
  b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  hit = 500 + int(rand() * 2000)
  for (i = 0; i < 3000; i++) {
    t = 20 * 3600 + i * 7
    stamp = sprintf("%02d:%02d:%02d", int(t / 3600) % 24, int(t / 60) % 60, t % 60)
    if (i == hit) { printf "%s user=%s action=LOGIN_OK token=%s\n", stamp, who, tok; continue }
    s = ""; for (k = 0; k < 20; k++) s = s substr(b, 1 + int(rand() * 64), 1)
    printf "%s user=%s action=%s token=%s\n", stamp, u[1 + int(rand() * 10)], a[1 + int(rand() * 5)], s
  }
}' > "$M/auth.log"
printf 'piece 3: %s\n' "$p3" > "$M/.door"
printf '#!/bin/sh\n# The last door. It only opens when this file has execute permission.\ncat ~/mission10/.door\n' > "$M/unlock.sh"
chmod 644 "$M/unlock.sh"
clue 10 "The flag is CYBA{piece1-piece2-piece3}: three pieces, joined with dashes.\n  Piece 1: in a hidden file somewhere under vault/  (some hidden files are decoys)\n  Piece 2: $who logged in once in auth.log. Their token is right after token=.\n  Piece 3: whatever unlock.sh prints.\n"

chmod 755 "$Q"; chmod 644 "$Q"/*
chown -R 1000:1000 "$H"
